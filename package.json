{
  "name": "goally-parent-mobile-automation",
  "version": "1.0.0",
  "private": true,
  "description": "WebdriverIO + Appium automation project wired for the Gavrix Appium MCP server.",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "appium": "/opt/homebrew/bin/appium server --address 127.0.0.1 --port 4723 --base-path /",
    "mcp": "appium-mcp",
    "test:android": "wdio run ./config/wdio.android.conf.js",
    "test:ios": "wdio run ./config/wdio.ios.conf.js",
    "drivers:list": "/opt/homebrew/bin/appium driver list --installed"
  },
  "devDependencies": {
    "@gavrix/appium-mcp": "^0.3.0",
    "@wdio/cli": "^9.24.0",
    "@wdio/globals": "^9.23.0",
    "@wdio/local-runner": "^9.24.0",
    "@wdio/mocha-framework": "^9.24.0",
    "@wdio/spec-reporter": "^9.24.0",
    "dotenv": "^17.3.1",
    "expect-webdriverio": "^5.6.4",
    "mocha": "^11.7.5",
    "webdriverio": "^9.24.0"
  }
}
